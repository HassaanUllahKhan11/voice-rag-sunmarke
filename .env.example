# Copy to .env and fill in. Without a key the assistant runs in extractive mode
# (quotes the sentences from the site that best match the question).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Tried in order if the main model fails (out of credits, retired, rate limited).
OPENROUTER_FALLBACK_MODELS=moonshotai/kimi-k2-0905

# Shown on demo pages as the "Want this on your website?" call to action.
OWNER_NAME=
OWNER_EMAIL=
OWNER_BOOKING_LINK=

# Questions allowed per visitor IP per 10 minutes.
RATE_LIMIT_PER_10_MIN=30
# Proxies in front of the app that append to X-Forwarded-For (1 for Vercel or Render).
TRUSTED_PROXY_HOPS=1
# Search score below which a question counts as "not on the website".
MIN_RELEVANT_SCORE=5.0
